      <aliases enabled='yes' />
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_1121550789160961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]* [Review Scores Rating]' />
      </column>
      <column caption='Pricing Categories' datatype='string' name='[Calculation_1121550789754882]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Price] &gt;=300 THEN &quot;Luxury&quot;&#13;&#10;ELSEIF [Price] &gt;=150 then &quot;Standard&quot;&#13;&#10;ELSE &quot;Budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Review Category' datatype='real' name='[Calculation_1121550791000067]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Number Of Reviews]&gt;=100 THEN &quot;Highly reviewed&quot;&#13;&#10;ELSE less reviewed&#13;&#10;END' />
      </column>
      <column caption='Host status' datatype='string' name='[Calculation_1121550791512068]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt;= TODAY() THEN &quot;Active Status&quot;&#13;&#10;ELSE &quot;New Host &quot;&#13;&#10;END' />
      </column>
      <column caption='Price filter category' datatype='string' name='[Calculation_1121550795390983]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;[Parameters].[Parameter 1121550793367558]&#13;&#10;then &quot;Abouve Limit&quot;&#13;&#10;ELSE&quot;Below Limit&quot;&#13;&#10;END' />
      </column>
